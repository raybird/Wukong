# syntax=docker/dockerfile:1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG PRODUCT_TAG
ARG BUILD_ORIGIN_TAG
ARG REVISION
ARG CREATED
ARG DEBIAN_SNAPSHOT
ARG OPENCODE_VERSION
ARG AGENT_REACH_REF
ARG AGENT_REACH_ARCHIVE_SHA256

LABEL org.opencontainers.image.source="https://github.com/raybird/Wukong" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.version="$BUILD_ORIGIN_TAG" \
      org.opencontainers.image.created="$CREATED"

RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|g" \
      -e "s|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|g" \
      /etc/apt/sources.list.d/debian.sources && \
    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git gh gosu nodejs npm python3 python3-pip pipx ripgrep fzf && \
    rm -rf /var/lib/apt/lists/*

COPY release/package.json release/package-lock.json /opt/wukong-release/
RUN cd /opt/wukong-release && npm ci --omit=dev && \
    ln -s /opt/wukong-release/node_modules/.bin/opencode /usr/local/bin/opencode

COPY binaries/wukong /usr/local/bin/wukong
COPY binaries/wukong-telegram /usr/local/bin/wukong-telegram
COPY binaries/wukong-web /usr/local/bin/wukong-web
COPY binaries/wukong-schedulerd /usr/local/bin/wukong-schedulerd
RUN chmod +x /usr/local/bin/wukong /usr/local/bin/wukong-telegram \
      /usr/local/bin/wukong-web /usr/local/bin/wukong-schedulerd

RUN useradd -m -s /bin/bash wukong
ENV HOME=/home/wukong
ENV PIPX_HOME=/home/wukong/.local/pipx
ENV PIPX_BIN_DIR=/home/wukong/.local/bin
ENV PATH="/home/wukong/.local/bin:/usr/local/bin:${PATH}"

RUN mkdir -p "$PIPX_HOME" "$PIPX_BIN_DIR" && chown -R wukong:wukong /home/wukong/.local && \
    curl -fsSL "https://github.com/Panniantong/agent-reach/archive/${AGENT_REACH_REF}.tar.gz" -o /tmp/agent-reach.tar.gz && \
    echo "${AGENT_REACH_ARCHIVE_SHA256}  /tmp/agent-reach.tar.gz" | sha256sum -c - && \
    gosu wukong pipx install /tmp/agent-reach.tar.gz && rm /tmp/agent-reach.tar.gz

COPY workspace/SOUL.md workspace/AGENTS.md /usr/local/share/wukong/
COPY crates/wukong-skills/assets/superpowers /usr/local/share/wukong/skills/superpowers
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV WUKONG_WORKSPACE=/workspace
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
